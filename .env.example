# ==============================================================================
# VelaWear_BE Environment Variables Template
# Copy this file to a new file named '.env' and fill in your actual credentials.
# Do NOT commit '.env' to git!
# ==============================================================================

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Database Settings
DB_URL=jdbc:postgresql://localhost:5432/VelaWear
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Separate HMAC key for OTP/proof digests, pseudonymous identifiers and token blacklist keys.
# Generate at least 32 random bytes and do not reuse either JWT signing key.
SECURITY_HMAC_SECRET=generate_a_random_security_hmac_secret_of_at_least_32_bytes

# Direct deployment must keep NONE. Only use NATIVE behind an explicitly trusted proxy.
SERVER_FORWARD_HEADERS_STRATEGY=NONE
# Required when SERVER_FORWARD_HEADERS_STRATEGY=NATIVE; Java regex matching proxy source IPs.
TRUSTED_PROXY_REGEX=(?!)
AUTH_RATE_LIMIT_ENABLED=true
OTP_REQUEST_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
OTP_ATTEMPTS_LOCK=10m

# JWT Security Settings
# Both JWT secret keys must be HS512 keys (minimum 64 characters / 512 bits) and must be different.
JWT_ACCESS_TOKEN_SECRET_KEY=generate_a_secure_random_access_token_key_of_at_least_64_characters
JWT_REFRESH_TOKEN_SECRET_KEY=generate_a_secure_random_refresh_token_key_of_at_least_64_characters
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=259200

# File Upload Settings
UPLOAD_BASE_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
UPLOAD_ALLOWED_FOLDERS=avatars,logos

# Swagger Documentation (dev profile only)
SWAGGER_UI_ENABLED=true
OPENAPI_DOCS_ENABLED=true

# Resend Email Settings
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional Vietnamese -> English catalog suggestions (Gemini, backend only)
# Keep the real key in .env or your deployment secret manager; never expose it to Frontend.
ENGLISH_CONTENT_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
# Optional provider/timeout overrides
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CONNECT_TIMEOUT=3s
GEMINI_READ_TIMEOUT=30s
ENGLISH_CONTENT_MAX_INPUT_CHARACTERS=30000
ENGLISH_CONTENT_MAX_OUTPUT_TOKENS=16384

# SePay Payment Gateway (production)
# Keep real credentials only in .env or your deployment secret manager.
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=production
SEPAY_MERCHANT_ID=SP-LIVE-your-merchant-id
SEPAY_SECRET_KEY=spsk_live_your-secret-key
SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_SUCCESS_URL=https://your-frontend-domain/payment/success
SEPAY_ERROR_URL=https://your-frontend-domain/payment/error
SEPAY_CANCEL_URL=https://your-frontend-domain/payment/cancel

# Google OAuth2 Login
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
OAUTH2_FRONTEND_SUCCESS_URL=http://localhost:3000/auth/oauth2/callback
OAUTH2_FRONTEND_FAILURE_URL=http://localhost:3000/sign-in
OAUTH2_LOGIN_CODE_TTL_SECONDS=120
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
