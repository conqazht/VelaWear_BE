# ==============================================================================
# VelaWear_BE Environment Variables Template
# Copy this file to a new file named '.env' and fill in your actual credentials.
# Do NOT commit '.env' to git!
# ==============================================================================

# Active Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Database Settings
DB_URL=jdbc:postgresql://localhost:5432/VelaWear
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# JWT Security Settings
# JWT_SECRET_KEY must be a HS512 key (minimum 64 characters / 512 bits)
JWT_SECRET_KEY=generate_a_secure_random_key_of_at_least_64_characters_long_for_production
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=259200

# File Upload Settings
UPLOAD_BASE_DIR=uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_MAX_SIZE_BYTES=5242880
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=6MB
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
UPLOAD_ALLOWED_FOLDERS=avatars,logos

# Swagger Documentation (dev profile only)
SWAGGER_UI_ENABLED=true
OPENAPI_DOCS_ENABLED=true
